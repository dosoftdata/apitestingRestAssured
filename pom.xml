<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>api.testinng.restAssured</groupId>
    <artifactId>apiTestingRestAssured</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <failsafe.plugin.version>3.5.4</failsafe.plugin.version>
        <jacoco.plugin.version>0.8.14</jacoco.plugin.version>
        <restassured.version>5.5.6</restassured.version>
        <cucumber.version>7.30.0</cucumber.version>
        <testng.version>7.8.0</testng.version>
        <allure.version>2.30.0</allure.version>
        <allure.maven.plugin.version>2.16.0</allure.maven.plugin.version>
        <logging.version>2.20.0</logging.version>
        <logging.api.version>2.0.9</logging.api.version>
        <logging.core.version>1.2.17</logging.core.version>
        <awaitability.version>4.2.0</awaitability.version>
        <lombok.version>1.18.30</lombok.version>
        <jackson.version>2.15.2</jackson.version>
        <env>dev</env>
    </properties>
    <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>${failsafe.plugin.version}</version>
            <configuration>
              <skipTests>true</skipTests>
            </configuration>
          </plugin>
          <!-- Maven Compile Plugin -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <source>${java.version}</source>
              <target>${java.version}</target>
            </configuration>
          </plugin>
          <!-- Allure Report Plugin -->
          <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure.maven.plugin.version}</version>
              <configuration>
                <!-- Where Allure will store raw result files (from your tests) -->
                <resultsDirectory>${project.basedir}/reports</resultsDirectory>
                <!-- Where the final HTML report will be generated -->
                <reportDirectory>${project.basedir}/reports/site</reportDirectory>
                  <serveHost>127.0.0.1</serveHost>
              </configuration>
              <executions>
                <!-- Automatically generate report during 'verify' phase -->
                <execution>
                  <id>allure-report</id>
                  <phase>verify</phase>
                  <goals>
                    <goal>report</goal>
                  </goals>
                </execution>
              </executions>
            </plugin>
          <!-- JaCoCo -->
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>${jacoco.plugin.version}</version>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
                <configuration>
                  <excludes>
                    <!-- Exclude all third-party libraries -->
                    <exclude>io/restassured/**</exclude>
                    <exclude>org/apache/**</exclude>
                    <exclude>com/google/**</exclude>
                  </excludes>
                </configuration>
              </execution>
              <execution>
                <id>report</id>
                <phase>post-integration-test</phase>
                <goals>
                  <goal>report</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <!-- Failsafe for integration tests -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>${failsafe.plugin.version}</version>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <systemPropertyVariables>
                <env>${env}</env>
                <allure.results.directory>${project.basedir}/reports</allure.results.directory>
              </systemPropertyVariables>
            </configuration>
          </plugin>
          <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>generate-test-sources</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.apitesting.core.testData.initGenerator</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${restassured.version}</version>
        </dependency>
        <dependency>
